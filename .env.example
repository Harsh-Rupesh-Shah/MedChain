# Server Configuration
PORT=8000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/medchain?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
NODE_ENV=development

CLIENT_URL=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Gmail OAuth API Configuration
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-google-refresh-token
SENDER_EMAIL=your-email@gmail.com

# Telemedicine Google Meet Room
GOOGLE_MEET_LINK=https://meet.google.com/new

VITE_API_URL=http://localhost:8000/api

